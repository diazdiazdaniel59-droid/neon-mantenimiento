# =============================================================================
# NEON :: api-gateway - Variables de entorno
# -----------------------------------------------------------------------------
# Plantilla para ejecutar el Gateway FUERA de Docker (desarrollo local):
#   Copy-Item .env.example .env
# Dentro de Docker la configuracion la inyecta docker-compose.yml.
# Cero valores quemados: todo se lee desde el entorno (12-Factor App).
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# --- Seguridad / JWT (el mismo secreto lo comparte ms-usuarios) ---
JWT_SECRET=neon_dev_secret_cambiar_en_produccion
JWT_ISSUER=neon

# --- URLs internas de los microservicios (host "localhost" fuera de Docker) ---
USERS_SERVICE_URL=http://localhost:3001
ACTIVOS_SERVICE_URL=http://localhost:3002
ORDENES_SERVICE_URL=http://localhost:3003
INVENTARIO_SERVICE_URL=http://localhost:3004

# --- CORS y proxy ---
CORS_ORIGIN=*
PROXY_TIMEOUT_MS=15000
