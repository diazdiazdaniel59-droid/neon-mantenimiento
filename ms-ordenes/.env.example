# =============================================================================
# NEON :: ms-ordenes - Variables de entorno
# -----------------------------------------------------------------------------
# Plantilla para ejecutar el servicio FUERA de Docker (desarrollo local):
#   Copy-Item .env.example .env
# Dentro de Docker la configuracion la inyecta docker-compose.yml.
# Cero valores quemados: todo se lee desde el entorno (12-Factor App).
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info
PORT=3003

# --- PostgreSQL (Database-per-Service: base exclusiva de ms-ordenes) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=neon_ordenes_db
PGUSER=neon_ordenes_user
PGPASSWORD=neon_ordenes_dev_pass
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

# --- Seguridad / JWT (el mismo secreto lo comparte API Gateway y ms-usuarios) ---
JWT_SECRET=neon_dev_secret_cambiar_en_produccion
JWT_ISSUER=neon

# --- RabbitMQ (broker de eventos asincronos) ---
RABBITMQ_URL=amqp://neon_app:rabbit_dev_pass@localhost:5672
RABBITMQ_EXCHANGE=neon_events
RABBITMQ_EXCHANGE_TYPE=topic

# --- Paginacion ---
MAX_PAGE_SIZE=100
