# =============================================================================
# NEON - Variables de entorno (FASE 1)
# -----------------------------------------------------------------------------
# USO:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
#
# REGLA (12-Factor App): cero valores quemados en el codigo.
# Toda configuracion (puertos, URLs, credenciales, secretos) vive aqui.
# Los valores indicados son los fallbacks de DESARROLLO LOCAL.
# En PRODUCCION todos deben sobreescribirse con valores reales y secretos.
# =============================================================================

# --- Entorno general ---
NODE_ENV=development
LOG_LEVEL=info

# --- API Gateway (punto unico de entrada) ---
GATEWAY_HOST_PORT=3000
GATEWAY_PORT=3000
# Origenes permitidos por CORS (separados por coma) o "*" en desarrollo.
CORS_ORIGIN=*
# Timeout (ms) de las peticiones del Gateway hacia los microservicios.
PROXY_TIMEOUT_MS=15000

# --- Puertos internos de los microservicios ---
USUARIOS_PORT=3001
ACTIVOS_PORT=3002
ORDENES_PORT=3003
INVENTARIO_PORT=3004

# --- Puertos host de la infraestructura ---
POSTGRES_HOST_PORT=5432
MONGO_HOST_PORT=27017
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672

# --- Seguridad / JWT (OBLIGATORIO cambiar en produccion) ---
# El mismo JWT_SECRET lo comparten API Gateway y ms-usuarios.
JWT_SECRET=neon_dev_secret_cambiar_en_produccion
JWT_ISSUER=neon
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# --- PostgreSQL (superusuario administrador del contenedor) ---
POSTGRES_USER=neon_admin
POSTGRES_PASSWORD=neon_admin_dev_pass
POSTGRES_DB=postgres

# --- Passwords de los roles por servicio (Database-per-Service) ---
# Deben coincidir con los servicios que las consumen (PGPASSWORD).
NEON_USUARIOS_DB_PASSWORD=neon_usuarios_dev_pass
NEON_ORDENES_DB_PASSWORD=neon_ordenes_dev_pass
NEON_INVENTARIO_DB_PASSWORD=neon_inventario_dev_pass

# --- MongoDB (host de ms-activos) ---
MONGO_INITDB_ROOT_USERNAME=neon_admin
MONGO_INITDB_ROOT_PASSWORD=mongo_dev_pass
# La URI usa el host interno "mongo" (solo resuelve dentro de la red Docker).
# Para correr ms-activos fuera de Docker, reemplazar "mongo" por "localhost".
MONGODB_URI=mongodb://neon_admin:mongo_dev_pass@mongo:27017/neon_activos_db?authSource=admin

# --- RabbitMQ (broker de eventos asincronos) ---
RABBITMQ_DEFAULT_USER=neon_app
RABBITMQ_DEFAULT_PASS=rabbit_dev_pass
# La URI usa el host interno "rabbitmq" (solo resuelve dentro de la red Docker).
# Si cambias RABBITMQ_DEFAULT_PASS, actualiza tambien esta URI.
RABBITMQ_URL=amqp://neon_app:rabbit_dev_pass@rabbitmq:5672
RABBITMQ_EXCHANGE=neon_events
RABBITMQ_EXCHANGE_TYPE=topic
# Cola durable y patron que consume ms-notificaciones (worker de eventos).
NOTIF_QUEUE=neon_notificaciones_queue
NOTIF_ROUTING_KEY=orden.#
NOTIF_PREFETCH=1
NOTIF_RECONNECT_MS=5000

# --- Semilla de administrador (opcional; se crea al arrancar ms-usuarios) ---
# Dejar vacio para no sembrar. Cambiar SIEMPRE en produccion.
SEED_ADMIN_EMAIL=admin@neon.local
SEED_ADMIN_PASSWORD=Admin12345
SEED_ADMIN_NOMBRE=Administrador NEON

# --- Notificaciones por correo (opcional en desarrollo) ---
# Si SMTP_HOST esta vacio, ms-notificaciones registra las alertas en consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=neon@localhost
# Destinatario de las alertas (si se omite, usa SMTP_FROM).
NOTIF_TO_EMAIL=

# --- Frontend (SPA React servida por Nginx) ---
# Puerto host donde se publica la SPA.
FRONTEND_HOST_PORT=8080
# URL del API Gateway horneada en el bundle en build-time.
# Debe ser accesible DESDE EL NAVEGADOR (por eso localhost, no el nombre interno).
VITE_API_URL=http://localhost:3000

# --- Despliegue en la nube (Render / PostgreSQL administrado) ---
# Si DATABASE_URL esta definida, tiene prioridad sobre PGHOST/PGPORT/PGDATABASE/
# PGUSER/PGPASSWORD en ms-usuarios, ms-ordenes y ms-inventario.
# Formato: postgresql://usuario:password@host:puerto/base
# DATABASE_URL=
# Exigir TLS en la conexion PostgreSQL (obligatorio en Neon/Supabase/Render).
# PGSSLMODE=require
