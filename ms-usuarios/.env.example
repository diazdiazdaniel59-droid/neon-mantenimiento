# =============================================================================
# NEON :: ms-usuarios - Variables de entorno
# -----------------------------------------------------------------------------
# Plantilla para ejecutar el servicio FUERA de Docker (desarrollo local):
#   Copy-Item .env.example .env
# Dentro de Docker la configuracion la inyecta docker-compose.yml.
# Cero valores quemados: todo se lee desde el entorno (12-Factor App).
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info
PORT=3001

# --- PostgreSQL (Database-per-Service: base exclusiva de ms-usuarios) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=neon_usuarios_db
PGUSER=neon_usuarios_user
PGPASSWORD=neon_usuarios_dev_pass
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

# --- Seguridad / JWT (el mismo secreto lo comparte API Gateway) ---
JWT_SECRET=neon_dev_secret_cambiar_en_produccion
JWT_ISSUER=neon
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# --- Paginacion ---
MAX_PAGE_SIZE=100

# --- Semilla de administrador (opcional, se crea al arrancar si no existe) ---
SEED_ADMIN_EMAIL=admin@neon.local
SEED_ADMIN_PASSWORD=Admin12345
SEED_ADMIN_NOMBRE=Administrador NEON
