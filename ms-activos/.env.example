# =============================================================================
# NEON :: ms-activos - Variables de entorno
# -----------------------------------------------------------------------------
# Plantilla para ejecutar el servicio FUERA de Docker (desarrollo local):
#   Copy-Item .env.example .env
# Dentro de Docker la configuracion la inyecta docker-compose.yml.
# Cero valores quemados: todo se lee desde el entorno (12-Factor App).
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info
PORT=3002

# --- MongoDB (Database-per-Service: base exclusiva de ms-activos) ---
# Fuera de Docker el host es "localhost"; dentro de Docker es "mongo".
MONGODB_URI=mongodb://neon_admin:mongo_dev_pass@localhost:27017/neon_activos_db?authSource=admin

# --- Seguridad / JWT (el mismo secreto lo comparte API Gateway y ms-usuarios) ---
JWT_SECRET=neon_dev_secret_cambiar_en_produccion
JWT_ISSUER=neon

# --- Paginacion ---
MAX_PAGE_SIZE=100
