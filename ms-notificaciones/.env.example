# =============================================================================
# NEON :: ms-notificaciones - Variables de entorno
# -----------------------------------------------------------------------------
# Plantilla para ejecutar el worker FUERA de Docker (desarrollo local):
#   Copy-Item .env.example .env
# Dentro de Docker la configuracion la inyecta docker-compose.yml.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# --- RabbitMQ (broker de eventos asincronos) ---
RABBITMQ_URL=amqp://neon_app:rabbit_dev_pass@localhost:5672
RABBITMQ_EXCHANGE=neon_events
RABBITMQ_EXCHANGE_TYPE=topic
# Cola durable y patron de enrutamiento que consume este worker
NOTIF_QUEUE=neon_notificaciones_queue
NOTIF_ROUTING_KEY=orden.#
NOTIF_PREFETCH=1
NOTIF_RECONNECT_MS=5000

# --- SMTP (opcional). Si SMTP_HOST esta vacio, las alertas se registran en el
#     log (transporte de consola) en lugar de enviarse por correo. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=neon@localhost
# Destinatario de las alertas (si se omite, se usa SMTP_FROM)
NOTIF_TO_EMAIL=
