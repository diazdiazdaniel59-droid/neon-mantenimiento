# =============================================================================
# NEON :: ms-inventario - Variables de entorno
# -----------------------------------------------------------------------------
# Plantilla para ejecutar el servicio FUERA de Docker (desarrollo local):
#   Copy-Item .env.example .env
# Dentro de Docker la configuracion la inyecta docker-compose.yml.
# Cero valores quemados: todo se lee desde el entorno (12-Factor App).
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info
PORT=3004

# --- PostgreSQL (Database-per-Service: base exclusiva de ms-inventario) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=neon_inventario_db
PGUSER=neon_inventario_user
PGPASSWORD=neon_inventario_dev_pass
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

# --- Seguridad / JWT (el mismo secreto lo comparte API Gateway y ms-usuarios) ---
JWT_SECRET=neon_dev_secret_cambiar_en_produccion
JWT_ISSUER=neon

# --- Paginacion ---
MAX_PAGE_SIZE=100
